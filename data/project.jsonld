      ]
    },
    {
      "@id": "card_a96044d6-fd98-4d98-ac77-07e81ac8be2a",
      "@type": "tg:Pattern",
      "type": "Pattern",
      "tier": 2,
      "title": "Civic Extraction in the Opacity Trap",
      "description": "As institutional channels reduce constituent feedback to non-binding data, digital media networks flood the resulting trust vacuum with disinformation, leaving citizens unable to verify ground truth or act effectively.",
      "x": 876.6187993681385,
      "y": -734.9982240159763,
