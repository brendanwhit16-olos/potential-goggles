    },
    {
      "@id": "item_21",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Uncontested Local Candidate Transparency",
      "description": "It is incredibly difficult to research the records of local election candidates, especially those running uncontested or without a communications budget, leaving voters feeling uninformed.",
      "x": 1480,
      "y": 300,
      "w": 240,
      "h": 110,
      "verified": false,
