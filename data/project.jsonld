      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Untapped Personal Megaphones",
      "description": "People forget how influential they can be with the biggest megaphone in history in the palm of their hand — but no one has cracked engagement at scale without it devolving into a rage machine.",
      "x": 4848,
      "y": 0,
      "w": 240,
      "h": 110,
