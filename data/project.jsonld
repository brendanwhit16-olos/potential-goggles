    },
    {
      "@id": "item_17",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Structural Election Imbalances",
      "description": "The current electoral system features gerrymandering, dominant two-party privileges, and districts so large that politicians effectively choose their voters.",
      "x": 2664,
      "y": 0,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
