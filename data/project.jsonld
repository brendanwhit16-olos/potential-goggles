      ]
    },
    {
      "@id": "card_d794ba6a-6fbf-4635-bd5c-cf1123d7f8b5",
      "@type": "tg:Pattern",
      "type": "Pattern",
      "tier": 2,
      "title": "The Structural Trap of Incremental Reform",
      "description": "Electoral rules and information voids combine to make gradual political change functionally impossible, convincing frustrated citizens that the system must be entirely replaced rather than improved.",
      "x": 2063.16705328359,
      "y": -860.6486495269953,
      "w": 300,
