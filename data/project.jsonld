      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Entertainment Crowds Out Civic Attention",
      "description": "Citizens are too busy consuming entertainment to pay attention to neighborhood issues, kids' activities, or their government; outreach across multiple mediums still meets 'I don't have time'.",
