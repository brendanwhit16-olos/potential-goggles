        "item_07"
      ]
    },
    {
      "@id": "card_22ac1f1d-0863-4bdd-ae65-c407b75927f9",
      "@type": "tg:Evidence",
      "type": "Evidence",
      "tier": 1,
      "title": "Binary Lock-In through Systemic Complexity",
      "description": "Dominant political parties maintain power through self-reinforcing election rules and high cognitive barriers, leaving voters unable to navigate or adopt alternative voting models.",
      "x": 2349.591233099472,
      "y": -403.17315484028825,
      "w": 280,
      "h": 150,
      "cardType": null,
      "locked": false,
      "children": [
        "item_04",
