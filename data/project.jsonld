    },
    {
      "@id": "card_1c5946f8-16c5-47c7-a11e-9a581edec5ed",
      "@type": "tg:Evidence",
      "type": "Evidence",
      "tier": 1,
      "title": "Unscaffolded Civic Duty",
      "description": "Everyday citizens and local volunteers face an overwhelming, unguided burden of civic participation, where missing playbooks, high friction, and misaligned expectations turn democratic responsibility into individual exhaustion and burnout.",
      "x": 3465.1489242126195,
      "y": -700.1021143195616,
      "w": 280,
