    },
    {
      "@id": "item_20",
      "@type": "tg:SourceExtract",
      "type": "Source Extract",
      "tier": 0,
      "title": "Aging Civic Leadership",
      "description": "Local civic organizations are heavily reliant on aging populations for leadership and membership, struggling to recruit younger generations who face competing career and family priorities.",
      "x": 3960,
      "y": 0,
      "w": 240,
      "h": 110,
      "verified": false,
      "strong": false,
